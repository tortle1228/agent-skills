#!/usr/bin/env sh
# Language-agnostic pre-push hook
# Guards protected branches, blocks unsquashed WIP/fixup commits, and runs optional local checks.
set -eu

REMOTE_NAME="${1:-origin}"
REMOTE_URL="${2:-}"
ZERO_OID="0000000000000000000000000000000000000000"

while read -r local_ref local_oid remote_ref remote_oid; do
  # Skip empty lines or branch deletion pushes
  if [ -z "${local_ref:-}" ] || [ "$local_oid" = "$ZERO_OID" ]; then
    continue
  fi

  # 1. Protected branch direct push guard
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/production)
      if [ "${ALLOW_PROTECTED_PUSH:-0}" != "1" ]; then
        branch_name="${remote_ref#refs/heads/}"
        printf '\n[pre-push] ERROR: direct push to protected branch (%s) blocked.\n' "$branch_name" >&2
        printf '  -> Create a feature branch and merge it through a pull request.\n' >&2
        printf '  -> Only when unavoidable, such as initial setup, use ALLOW_PROTECTED_PUSH=1 git push.\n\n' >&2
        exit 1
      fi
      ;;
  esac

  # 2. Check unpushed commit range for WIP or unsquashed fixup!/squash! commits
  if [ "${ALLOW_WIP_PUSH:-0}" != "1" ]; then
    if [ "$remote_oid" = "$ZERO_OID" ]; then
      COMMITS=$(git rev-list "$local_oid" --not --remotes="$REMOTE_NAME" 2>/dev/null || git rev-list "$local_oid")
    else
      COMMITS=$(git rev-list "${remote_oid}..${local_oid}")
    fi

    if [ -n "$COMMITS" ]; then
      WIP_COMMITS=$(git log --no-walk --format='%h %s' $COMMITS | grep -E '^[0-9a-f]+ (fixup!|squash!|amend!|WIP:|wip:)' || true)
      if [ -n "$WIP_COMMITS" ]; then
        printf '\n[pre-push] ERROR: push aborted; it contains WIP or unsquashed fixup/squash commits:\n' >&2
        printf '%s\n' "$WIP_COMMITS" >&2
        printf '  -> Clean them up with git rebase -i --autosquash, then push again.\n\n' >&2
        exit 1
      fi
    fi
  fi
done

# 3. Optional repository-specific test/build runner
REPO_ROOT=$(git rev-parse --show-toplevel)
if [ -x "${REPO_ROOT}/.githooks/pre-push.local" ]; then
  "${REPO_ROOT}/.githooks/pre-push.local" "$REMOTE_NAME" "$REMOTE_URL"
fi

exit 0
