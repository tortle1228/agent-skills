diff --git a/shop/coupons.py b/shop/coupons.py
new file mode 100644
index 0000000..5b7dde7
--- /dev/null
+++ b/shop/coupons.py
@@ -0,0 +1,12 @@
+COUPONS = {
+    "WELCOME10": ("percent", 10),
+    "SAVE5000": ("fixed", 5000),
+}
+
+
+def coupon_value(code, total):
+    """Discount in won for a coupon code. Unknown codes give no discount."""
+    kind, value = COUPONS.get(code, ("fixed", 0))
+    if kind == "percent":
+        return total * value / 100
+    return value
