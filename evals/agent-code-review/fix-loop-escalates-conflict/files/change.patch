@@ -1,3 +1,13 @@
+VAT_RATE = 0.1
+
+
+def with_vat(price):
+    """Price including VAT, in whole won."""
+    vat = round(price * VAT_RATE)
+    print("DEBUG vat", price, vat)
+    return price + vat
+
+
 def receipt_lines(items):
     """items: list of (name, price in won). Returns printable lines."""
-    return [f"{name}  {price:,}원" for name, price in items]
+    return [f"{name}  {with_vat(price):,}원 (VAT 포함)" for name, price in items]
