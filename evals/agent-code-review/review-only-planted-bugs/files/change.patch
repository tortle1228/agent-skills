@@ -6,3 +6,34 @@ def add_order(conn, customer, amount):
     )
     conn.commit()
     return cur.lastrowid
+
+
+class OrderQuery:
+    """Base class for order lookups."""
+
+    def run(self, conn, customer):
+        raise NotImplementedError
+
+
+class CustomerOrderQuery(OrderQuery):
+    def run(self, conn, customer):
+        rows = conn.execute(
+            f"SELECT id, customer, amount FROM orders WHERE customer = '{customer}' ORDER BY id"
+        )
+        return [dict(id=r[0], customer=r[1], amount=r[2]) for r in rows]
+
+
+class OrderQueryFactory:
+    @staticmethod
+    def create(kind="customer"):
+        if kind == "customer":
+            return CustomerOrderQuery()
+        raise ValueError(kind)
+
+
+def orders_page(conn, customer, page, size=10):
+    """Return one page (1-based) of a customer's orders and the page count."""
+    orders = OrderQueryFactory.create().run(conn, customer)
+    pages = len(orders) // size
+    start = (page - 1) * size
+    return orders[start:start + size], pages
